{
  "name": "fen grubber",
  "description": "grab fens from some webpages",
  "icons": {
    "128": "ICONBUNNY.png"
  },
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "click to grub fen"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite", "clipboardRead"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "chess-pgn-command": {
      "suggested_key": {
	"default": "Ctrl+Shift+F",
	"mac": "Command+Shift+F"
      },
      "description": "from current game, open lichess analysis with game's pgn"
    },
    "crossword-link-command": {
      "suggested_key": {
	"default": "Ctrl+Shift+L",
	"mac": "Command+Shift+L"
      },
      "description": "put link to share with others in clipboard"
    },
    "crossword-check-command": {
      "suggested_key": {
	"default": "Ctrl+Shift+Q",
	"mac": "Command+Shift+Q"
      },
      "description": "check crossword without clicking"
    },
    "crossword-clue-command": {
      "suggested_key": {
	"default": "Ctrl+Shift+S",
	"mac": "Command+Shift+S"
      },
      "description": "search currently highlighted crossword clue in new tab"
    }
  },
  "content_scripts": [{
    "matches": ["*://www.chess.com/*"],
    "css": ["chesscom-styles.css"],
    "js": ["alas-alas.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["pics/*"],
    "matches": ["*://www.chess.com/*"]
  }]
}
